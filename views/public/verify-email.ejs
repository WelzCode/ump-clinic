<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Email Verification</h4>
                </div>
                <div class="card-body text-center">
                    <% if (success) { %>
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <h5>Verification Successful!</h5>
                            <p class="mb-0"><%= message %></p>
                        </div>
                        <a href="/auth/login" class="btn btn-primary">Proceed to Login</a>
                    <% } else { %>
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle fa-3x text-danger mb-3"></i>
                            <h5>Verification Failed</h5>
                            <p class="mb-3"><%= message %></p>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="/auth/resend-verification" class="btn btn-outline-primary">
                                Resend Verification Email
                            </a>
                            <a href="/auth/login" class="btn btn-secondary">Back to Login</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>