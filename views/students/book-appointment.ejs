<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Appointment - UMP Health Clinic</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <style>
        /* Reset and Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            /* Primary Colors */
            --primary: #000000;
            --primary-dark: #3a64ed;
            --primary-light: #8b92fa;
            
            /* Neutral Colors */
            --background: #FFFFFF;
            --surface: #F8FAFC;
            --surface-dark: #F1F5F9;
            --border: #E2E8F0;
            --text: #1E293B;
            --text-muted: #64748B;
            --text-light: #94A3B8;
            
            /* Accent Colors */
            --accent: #10B981;
            --accent-red: #EF4444;
            --accent-orange: #F59E0B;
            
            /* Typography */
            --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --font-size-xs: 0.75rem;
            --font-size-sm: 0.875rem;
            --font-size-base: 1rem;
            --font-size-lg: 1.125rem;
            --font-size-xl: 1.25rem;
            --font-size-2xl: 1.5rem;
            --font-size-3xl: 1.875rem;
            --font-size-4xl: 2.25rem;
            
            /* Spacing */
            --spacing-xs: 0.5rem;
            --spacing-sm: 0.75rem;
            --spacing-md: 1rem;
            --spacing-lg: 1.5rem;
            --spacing-xl: 2rem;
            --spacing-2xl: 3rem;
            
            /* Border Radius */
            --radius-sm: 0.375rem;
            --radius-md: 0.5rem;
            --radius-lg: 0.75rem;
            --radius-xl: 1rem;
            
            /* Shadows */
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }

        body {
            font-family: var(--font-family);
            line-height: 1.6;
            color: var(--text);
            background-color: var(--surface);
            font-size: var(--font-size-base);
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 var(--spacing-lg);
        }

        /* Typography */
        h1, h2, h3, h4, h5, h6 {
            font-weight: 600;
            line-height: 1.2;
            color: var(--text);
        }

        h1 { font-size: var(--font-size-3xl); }
        h2 { font-size: var(--font-size-2xl); }
        h3 { font-size: var(--font-size-xl); }

        p {
            color: var(--text-muted);
            line-height: 1.6;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: var(--spacing-sm) var(--spacing-lg);
            border: none;
            border-radius: var(--radius-md);
            font-size: var(--font-size-sm);
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-primary {
            background-color: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-secondary {
            background-color: transparent;
            color: var(--text);
            border: 1px solid var(--border);
        }

        .btn-secondary:hover {
            background-color: var(--surface);
            border-color: var(--primary);
        }

        .btn-large {
            padding: var(--spacing-md) var(--spacing-xl);
            font-size: var(--font-size-base);
        }

        /* Announcement Bar */
        .announcement-bar {
            background-color: var(--primary);
            color: white;
            padding: var(--spacing-sm) 0;
            text-align: center;
            font-size: var(--font-size-sm);
        }

        /* Navigation */
        .navbar {
            background-color: var(--background);
            border-bottom: 1px solid var(--border);
            padding: var(--spacing-md) 0;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
        }

        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--text);
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            border-radius: var(--radius-md);
            position: relative;
        }

        .logo-icon::after {
            content: '+';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-weight: bold;
            font-size: 18px;
        }

        .nav-menu {
            display: flex;
            align-items: center;
            gap: var(--spacing-xl);
        }

        .nav-link {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .nav-link:hover {
            color: var(--primary);
        }

        .nav-toggle {
            display: none;
            flex-direction: column;
            cursor: pointer;
            gap: 4px;
        }

        .nav-toggle span {
            width: 24px;
            height: 2px;
            background-color: var(--text);
            transition: all 0.3s ease;
        }

        /* Book Appointment Page Styles */
        .book-appointment-page {
            padding: var(--spacing-2xl) 0;
        }

        .page-header {
            margin-bottom: var(--spacing-xl);
        }

        .page-header h1 {
            margin-bottom: var(--spacing-sm);
        }

        .alert {
            padding: var(--spacing-md);
            border-radius: var(--radius-md);
            margin-bottom: var(--spacing-lg);
            border-left: 4px solid;
        }

        .alert-danger {
            background-color: rgba(239, 68, 68, 0.1);
            border-left-color: var(--accent-red);
            color: var(--text);
        }

        .alert-success {
            background-color: rgba(16, 185, 129, 0.1);
            border-left-color: var(--accent);
            color: var(--text);
        }

        .alert-info {
            background-color: rgba(0, 26, 255, 0.1);
            border-left-color: var(--primary);
            color: var(--text);
        }

        .booking-card {
            background: white;
            border-radius: var(--radius-lg);
            padding: var(--spacing-xl);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            margin-bottom: var(--spacing-xl);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-lg);
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-xs);
        }

        .form-label {
            font-weight: 500;
            color: var(--text);
            font-size: var(--font-size-sm);
        }

        .form-control {
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            font-size: var(--font-size-sm);
            transition: border-color 0.2s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(0, 26, 255, 0.1);
        }

        .slots-section {
            margin-top: var(--spacing-lg);
        }

        .slots-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-md);
        }

        .slots-container {
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: var(--spacing-lg);
            background: var(--surface);
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .loading-state {
            text-align: center;
            color: var(--text-muted);
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid var(--border);
            border-top: 3px solid var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto var(--spacing-md);
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .slots-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: var(--spacing-sm);
            width: 100%;
        }

        .time-slot {
            padding: var(--spacing-sm);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: var(--font-size-sm);
            font-weight: 500;
        }

        .time-slot.available {
            background-color: rgba(16, 185, 129, 0.1);
            border-color: rgba(16, 185, 129, 0.3);
            color: var(--accent);
        }

        .time-slot.available:hover {
            background-color: rgba(16, 185, 129, 0.2);
            transform: translateY(-1px);
        }

        .time-slot.unavailable {
            background-color: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.3);
            color: var(--accent-red);
            cursor: not-allowed;
            opacity: 0.6;
        }

        .time-slot.past {
            background-color: var(--surface-dark);
            border-color: var(--border);
            color: var(--text-muted);
            cursor: not-allowed;
            opacity: 0.5;
        }

        .time-slot.selected {
            background-color: var(--primary);
            border-color: var(--primary);
            color: white;
            transform: scale(1.05);
        }

        .time-slot.selected:hover {
            background-color: var(--primary-dark);
        }

        .slot-info {
            font-size: var(--font-size-xs);
            margin-top: 2px;
        }

        .form-actions {
            display: flex;
            gap: var(--spacing-md);
            margin-top: var(--spacing-xl);
        }

        .info-card {
            background: white;
            border-radius: var(--radius-lg);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
        }

        .info-card h3 {
            margin-bottom: var(--spacing-md);
            font-size: var(--font-size-lg);
        }

        .info-item {
            display: flex;
            justify-content: space-between;
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid var(--border);
        }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-label {
            font-weight: 500;
            color: var(--text);
        }

        .info-value {
            color: var(--text-muted);
        }

        /* Footer */
        .footer {
            background-color: var(--text);
            color: white;
            padding: var(--spacing-xl) 0;
            margin-top: var(--spacing-2xl);
        }

        .footer-content {
            text-align: center;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .container {
                padding: 0 var(--spacing-md);
            }
            
            .nav-menu {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: white;
                flex-direction: column;
                padding: var(--spacing-lg);
                box-shadow: var(--shadow-lg);
                gap: var(--spacing-md);
            }
            
            .nav-menu.active {
                display: flex;
            }
            
            .nav-toggle {
                display: flex;
            }
            
            .form-grid {
                grid-template-columns: 1fr;
            }
            
            .slots-grid {
                grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            }
            
            .form-actions {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <!-- Announcement Bar -->
    <div class="announcement-bar">
        <div class="container">
            <p>🩺 Book your appointment online - Quick and easy scheduling!</p>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <a href="/" style="text-decoration: none;">
                    <div class="logo">
                        <div class="logo-iconas" >
                            <img 
                                src="https://upload.wikimedia.org/wikipedia/en/thumb/0/00/University_of_Mpumalanga_logo.svg/1200px-University_of_Mpumalanga_logo.svg.png"
                                alt="ump icon"
                                style="width: 50px; height: 50px; object-fit: contain; margin-top: 4px;"
                            >
                        </div>
                        <span style="font-weight: 100;">Clinic</span>
                    </div>
                </a>
            </div>
            <div class="nav-menu" id="navMenu">
                <a href="/student" class="nav-link">Dashboard</a>
                <a href="/student/book-appointment" class="nav-link active">Book Appointment</a>
                <a href="/student/my-appointments" class="nav-link">Appointments</a>
                <a href="/student/medical-records" class="nav-link">Records</a>
                <a href="/student/profile" class="nav-link">Profile</a>
                <a href="/auth/logout" class="nav-link">Logout</a>
            </div>
            <div class="nav-toggle" id="navToggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Book Appointment Page Content -->
    <section class="book-appointment-page">
        <div class="container">
            <div class="page-header">
                <h1>Book an Appointment</h1>
                <p>Schedule your visit with our healthcare professionals</p>
            </div>

            <!-- Alert Messages -->
            <% if (messages && messages.error && messages.error.length > 0) { %>
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> <%= messages.error[0] %>
                </div>
            <% } %>
            
            <% if (messages && messages.success && messages.success.length > 0) { %>
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> <%= messages.success[0] %>
                </div>
            <% } %>

            <div class="booking-card">
                <form id="appointmentForm" method="POST" action="/student/book-appointment">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="service_id" class="form-label">Service Type *</label>
                            <select class="form-control" id="service_id" name="service_id" required>
                                <option value="">Select a service</option>
                                <% services.forEach(function(service) { %>
                                    <option value="<%= service.id %>"><%= service.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="appointment_date" class="form-label">Appointment Date *</label>
                            <input type="date" class="form-control" id="appointment_date" name="appointment_date" required>
                            <div id="dateWarning" class="text-warning" style="display: none; font-size: var(--font-size-sm); margin-top: var(--spacing-xs);">
                                <i class="fas fa-exclamation-triangle"></i> You already have an appointment scheduled for this date
                            </div>
                        </div>
                    </div>

                    <div class="slots-section">
                        <div class="slots-header">
                            <h3>Available Time Slots</h3>
                            <span class="text-muted" id="slotsCount">Select date and service first</span>
                        </div>
                        
                        <div class="slots-container">
                            <div id="initialState" class="loading-state">
                                <i class="far fa-calendar-alt" style="font-size: 3rem; margin-bottom: var(--spacing-md); color: var(--border);"></i>
                                <p>Please select a service and date to see available time slots</p>
                            </div>
                            
                            <div id="loadingState" class="loading-state" style="display: none;">
                                <div class="loading-spinner"></div>
                                <p>Loading available slots...</p>
                            </div>
                            
                            <div id="slotsGrid" class="slots-grid" style="display: none;"></div>
                            
                            <div id="noSlotsState" class="loading-state" style="display: none;">
                                <i class="far fa-calendar-times" style="font-size: 3rem; margin-bottom: var(--spacing-md); color: var(--border);"></i>
                                <p>No available slots for the selected date and service</p>
                            </div>
                            
                            <div id="errorState" class="loading-state" style="display: none;">
                                <i class="fas fa-exclamation-triangle" style="font-size: 3rem; margin-bottom: var(--spacing-md); color: var(--accent-red);"></i>
                                <p id="errorMessage">Error loading available slots</p>
                            </div>

                            <div id="dailyLimitState" class="loading-state" style="display: none;">
                                <i class="fas fa-calendar-day" style="font-size: 3rem; margin-bottom: var(--spacing-md); color: var(--accent-orange);"></i>
                                <h4>Daily Appointment Limit Reached</h4>
                                <p>You already have an appointment scheduled for this date. Students are limited to one appointment per day.</p>
                                <a href="/student/my-appointments" class="btn btn-outline-primary btn-sm mt-2">
                                    <i class="fas fa-list"></i> View My Appointments
                                </a>
                            </div>
                        </div>
                        
                        <input type="hidden" id="appointment_time" name="appointment_time" required>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary btn-large" id="bookBtn" disabled>
                            <i class="fas fa-calendar-check"></i> Book Appointment
                        </button>
                        <a href="/student" class="btn btn-secondary btn-large">Cancel</a>
                    </div>
                </form>
            </div>

            <div class="info-card">
                <h3><i class="fas fa-info-circle"></i> Clinic Information</h3>
                <div class="info-item">
                    <span class="info-label">Opening Time:</span>
                    <span class="info-value"><%= settings.opening_time || '09:00' %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Closing Time:</span>
                    <span class="info-value"><%= settings.closing_time || '17:00' %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Appointment Duration:</span>
                    <span class="info-value"><%= settings.appointment_duration || 30 %> minutes</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Location:</span>
                    <span class="info-value">UMP Mbombela Campus, Building 11, Room 1011</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2025 University of Mpumalanga Health Clinic. All rights reserved.</p>
                <p style="color: white;">Emergency: Call 013 002 0001 (UMP Emergency) or 10177 (National Emergency)</p>
            </div>
        </div>
    </footer>

    <script>
        // Mobile Navigation Toggle
        const navToggle = document.getElementById('navToggle');
        const navMenu = document.getElementById('navMenu');

        navToggle.addEventListener('click', () => {
            navMenu.classList.toggle('active');
            
            // Animate hamburger menu
            const spans = navToggle.querySelectorAll('span');
            spans.forEach((span, index) => {
                if (navMenu.classList.contains('active')) {
                    if (index === 0) span.style.transform = 'rotate(45deg) translate(5px, 5px)';
                    if (index === 1) span.style.opacity = '0';
                    if (index === 2) span.style.transform = 'rotate(-45deg) translate(7px, -6px)';
                } else {
                    span.style.transform = 'none';
                    span.style.opacity = '1';
                }
            });
        });

        // Global variables
        let selectedSlot = null;
        let hasExistingAppointment = false;
        const today = new Date().toISOString().split('T')[0];
        
        // Set minimum date to today
        document.getElementById('appointment_date').min = today;
        document.getElementById('appointment_date').value = today;

        // Event listeners for form changes
        document.getElementById('service_id').addEventListener('change', checkDailyLimitAndFetchSlots);
        document.getElementById('appointment_date').addEventListener('change', checkDailyLimitAndFetchSlots);

        // Function to check daily limit and fetch slots
        function checkDailyLimitAndFetchSlots() {
            const serviceId = document.getElementById('service_id').value;
            const date = document.getElementById('appointment_date').value;
            
            // Reset selection
            selectedSlot = null;
            document.getElementById('appointment_time').value = '';
            document.getElementById('bookBtn').disabled = true;
            document.getElementById('dateWarning').style.display = 'none';
            hasExistingAppointment = false;
            
            if (!serviceId || !date) {
                showInitialState();
                return;
            }
            
            // First check if student already has an appointment on this date
            checkExistingAppointment(date).then(hasAppointment => {
                if (hasAppointment) {
                    showDailyLimitState();
                    hasExistingAppointment = true;
                    document.getElementById('dateWarning').style.display = 'block';
                } else {
                    // If no existing appointment, fetch available slots
                    fetchAvailableSlots(serviceId, date);
                }
            }).catch(error => {
                console.error('Error checking daily limit:', error);
                fetchAvailableSlots(serviceId, date); // Proceed with slot fetching even if check fails
            });
        }

        // Function to check if student already has an appointment on the selected date
        function checkExistingAppointment(date) {
            return new Promise((resolve, reject) => {
                fetch(`/student/check-daily-appointment?date=${date}`)
                    .then(response => response.json())
                    .then(data => {
                        resolve(data.hasAppointment);
                    })
                    .catch(error => {
                        console.error('Error checking daily appointment:', error);
                        reject(error);
                    });
            });
        }

        // Function to fetch available slots
        function fetchAvailableSlots(serviceId, date) {
            showLoadingState();
            
            fetch(`/student/available-slots?service_id=${serviceId}&date=${date}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(slots => {
                    if (slots.error) {
                        showErrorState(slots.error);
                        return;
                    }
                    
                    if (!Array.isArray(slots) || slots.length === 0) {
                        showNoSlotsState();
                        return;
                    }
                    
                    displaySlots(slots, date);
                })
                .catch(error => {
                    console.error('Error fetching slots:', error);
                    showErrorState('Error loading available slots. Please try again.');
                });
        }

        // Function to display slots
        function displaySlots(slots, selectedDate) {
            const slotsGrid = document.getElementById('slotsGrid');
            const now = new Date();
            const isToday = selectedDate === today;
            
            slotsGrid.innerHTML = '';
            
            let availableCount = 0;
            
            slots.forEach(slot => {
                // Check if this slot is in the past (for today only)
                let isPast = false;
                if (isToday) {
                    const [hours, minutes] = slot.value.split(':');
                    const slotTime = new Date();
                    slotTime.setHours(parseInt(hours), parseInt(minutes), 0, 0);
                    
                    if (slotTime < now) {
                        isPast = true;
                    }
                }
                
                const slotElement = document.createElement('div');
                let slotClass = 'time-slot ';
                let onClick = '';
                
                if (slot.available && !isPast && !hasExistingAppointment) {
                    slotClass += 'available';
                    onClick = `selectSlot('${slot.value}', this)`;
                    availableCount++;
                } else if (isPast) {
                    slotClass += 'past';
                } else if (hasExistingAppointment) {
                    slotClass += 'unavailable';
                } else {
                    slotClass += 'unavailable';
                }
                
                slotElement.className = slotClass;
                slotElement.setAttribute('onclick', onClick);
                
                slotElement.innerHTML = `
                    ${slot.display}
                    ${!slot.available || isPast || hasExistingAppointment ? 
                        '<div class="slot-info">' + 
                        (isPast ? 'Past' : (hasExistingAppointment ? 'Daily limit' : (slot.reason || 'Booked'))) + 
                        '</div>' : ''}
                `;
                
                slotsGrid.appendChild(slotElement);
            });
            
            // Update slots count
            if (hasExistingAppointment) {
                document.getElementById('slotsCount').textContent = 'Daily appointment limit reached';
            } else {
                document.getElementById('slotsCount').textContent = `${availableCount} available slot${availableCount !== 1 ? 's' : ''}`;
            }
            
            // Show slots grid
            showSlotsGrid();
        }

        // Function to select a time slot
        function selectSlot(time, element) {
            if (hasExistingAppointment) {
                alert('You already have an appointment scheduled for this date. Students are limited to one appointment per day.');
                return;
            }
            
            // Remove selected class from all slots
            document.querySelectorAll('.time-slot').forEach(slot => {
                slot.classList.remove('selected');
            });
            
            // Add selected class to clicked slot
            element.classList.add('selected');
            
            // Set the selected time
            selectedSlot = time;
            document.getElementById('appointment_time').value = time;
            
            // Enable book button
            document.getElementById('bookBtn').disabled = false;
        }

        // State management functions
        function showInitialState() {
            hideAllStates();
            document.getElementById('initialState').style.display = 'block';
            document.getElementById('slotsCount').textContent = 'Select date and service first';
        }
        
        function showLoadingState() {
            hideAllStates();
            document.getElementById('loadingState').style.display = 'block';
            document.getElementById('slotsCount').textContent = 'Loading...';
        }
        
        function showSlotsGrid() {
            hideAllStates();
            document.getElementById('slotsGrid').style.display = 'grid';
        }
        
        function showNoSlotsState() {
            hideAllStates();
            document.getElementById('noSlotsState').style.display = 'block';
            document.getElementById('slotsCount').textContent = 'No available slots';
        }
        
        function showErrorState(message) {
            hideAllStates();
            document.getElementById('errorState').style.display = 'block';
            document.getElementById('errorMessage').textContent = message;
            document.getElementById('slotsCount').textContent = 'Error';
        }
        
        function showDailyLimitState() {
            hideAllStates();
            document.getElementById('dailyLimitState').style.display = 'block';
            document.getElementById('slotsCount').textContent = 'Daily limit reached';
        }
        
        function hideAllStates() {
            document.getElementById('initialState').style.display = 'none';
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('slotsGrid').style.display = 'none';
            document.getElementById('noSlotsState').style.display = 'none';
            document.getElementById('errorState').style.display = 'none';
            document.getElementById('dailyLimitState').style.display = 'none';
        }

        // Form validation
        document.getElementById('appointmentForm').addEventListener('submit', function(e) {
            if (hasExistingAppointment) {
                e.preventDefault();
                alert('You already have an appointment scheduled for this date. Students are limited to one appointment per day.');
                return;
            }
            
            if (!selectedSlot) {
                e.preventDefault();
                alert('Please select an available time slot.');
                return;
            }
            
            // Additional validation for past times
            const selectedDate = document.getElementById('appointment_date').value;
            if (selectedDate === today) {
                const [hours, minutes] = selectedSlot.split(':');
                const slotTime = new Date();
                slotTime.setHours(parseInt(hours), parseInt(minutes), 0, 0);
                
                if (slotTime < new Date()) {
                    e.preventDefault();
                    alert('You cannot book an appointment for a time that has already passed. Please select a future time slot.');
                    return;
                }
            }
            
            // Show loading state on form submission
            document.getElementById('bookBtn').innerHTML = '<i class="fas fa-spinner fa-spin"></i> Booking...';
            document.getElementById('bookBtn').disabled = true;
        });

        // Initialize the page
        document.addEventListener('DOMContentLoaded', function() {
            // Set today's date as default
            document.getElementById('appointment_date').value = today;
            
            // If a service is pre-selected, check daily limit
            const serviceId = document.getElementById('service_id').value;
            if (serviceId) {
                checkDailyLimitAndFetchSlots();
            }
        });
    </script>
</body>
</html>