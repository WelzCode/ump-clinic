<%- include('../partials/header', { title: 'Nurse Dashboard' }) -%>
<%- include('../partials/navigation') -%>
<%- include('../partials/flash-messages') -%>

<div class="container mt-4">
    <h2>Nurse Dashboard</h2>
    <p class="text-muted">Welcome, <%= user.full_name %></p>
    
    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Today's Appointments (<%= today %>)</h5>
                </div>
                <div class="card-body">
                    <% if (appointments && appointments.length > 0) { %>
                        <div class="list-group">
                            <% appointments.forEach(function(appointment) { %>
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1"><%= appointment.student_name %></h6>
                                            <small class="text-muted">
                                                <%= appointment.service_name %> at <%= appointment.appointment_time %>
                                            </small>
                                        </div>
                                        <a href="/nurse/consultation/<%= appointment.id %>" class="btn btn-primary btn-sm">Start Consultation</a>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="text-muted">No appointments scheduled for today</p>
                    <% } %>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/nurse/patient-queue" class="btn btn-outline-primary">View Patient Queue</a>
                        <a href="/nurse/profile" class="btn btn-outline-secondary">My Profile</a>
                    </div>
                </div>
            </div>
            
            <div class="card mt-3">
                <div class="card-header">
                    <h6>Today's Statistics</h6>
                </div>
                <div class="card-body">
                    <p class="mb-1">Appointments: <strong><%= appointments ? appointments.length : 0 %></strong></p>
                    <p class="mb-0">Completed: <strong>0</strong></p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') -%>